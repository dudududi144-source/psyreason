{
  "name": "psyreason",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "PsyReason - Complete Reason clone in the browser for psytrance production",
  "workspaces": [
    "foundation",
    "devices",
    "host",
    "ui"
  ],
  "scripts": {
    "dev": "bun run --cwd ui dev",
    "build": "bun run --cwd ui build",
    "preview": "bun run --cwd ui preview",
    "test": "bun test tests/",
    "test:coverage": "bun test tests/ --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --cwd ui exec tsc --noEmit",
    "clean": "rm -rf node_modules ui/node_modules ui/dist"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.0",
    "bun-types": "^1.3.4"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "license": "MIT"
}
