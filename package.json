{
  "name": "psyreason",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PsyReason - Complete Reason clone in the browser",
  "workspaces": [
    "foundation/*",
    "devices/*",
    "host/*",
    "ui"
  ],
  "scripts": {
    "dev": "bun run --cwd ui dev",
    "build": "bun run build:ui",
    "build:ui": "bun run --cwd ui build",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules dist .next"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.0",
    "bun-types": "^1.3.4"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "license": "MIT"
}